#!/usr/bin/env bash

# ==============================================================================
# Ollama on K3D - クラスタ設定変数 (Single Source of Truth)
# Server: 1ノード (8コア: CORE, モニタリング, SSO)
# Worker: 1ノード (24コア: AI, GPU/NPU, LLM)
# ==============================================================================

# クラスタ設定
CLUSTER_NAME="ollama-cluster"
CLUSTER_ISSUER_NAME="internal-ca-issuer"
SERVERS=1
AGENTS=1

# ノード CPU コア配分 (AMD Ryzen AI MAX+ 395 32コア構成)
SERVER_CPUS=8
SERVER_CPUSET="0-7"
AGENT_CPUS=24
AGENT_CPUSET="8-31"

# イメージ設定（空の場合、最新安定版を自動取得）
IMAGE=""

# ネットワーク設定
NETWORK="k3d"
ENABLE_NETWORK_POLICY=true

# K3s 設定
DISABLE_TRAEFIK=false
KUBELET_USER_NAMESPACE=true
PRE_IMPORT_IMAGES=true
# k3s datastore が etcd の場合 (SERVERS > 1) のみ true。sqlite datastore では etcd が無いため false
K3S_ETCD_METRICS_ENABLED=false

# k3d ノードへの GPU パススルー (k3d CLI --gpus 相当 / config.yaml options.runtime.gpuRequest)
K3D_GPUS="all"

# イメージ正規化フォールバック用一時アーカイブ保存先
IMAGE_ARCHIVE_DIR="/var/tmp/k3d-image-import"

# タイミング・リトライ設定
DEFAULT_ROLLOUT_TIMEOUT="300s"
EXTENDED_ROLLOUT_TIMEOUT="600s"
LONG_ROLLOUT_TIMEOUT="1200s"
HELM_TIMEOUT="15m"
NODE_READY_TIMEOUT="300s"
K3D_CREATE_TIMEOUT="300s"
POD_DELETE_TIMEOUT="30s"
DEFAULT_RETRY_COUNT=60
DEFAULT_RETRY_DELAY=5
QUICK_RETRY_COUNT=3
QUICK_RETRY_DELAY=10
STEADY_RETRY_COUNT=5
STEADY_RETRY_DELAY=15
STANDARD_RETRY_COUNT=20
STANDARD_RETRY_DELAY=5
ONCE_RETRY_COUNT=1
CURL_CONNECT_TIMEOUT=5
CURL_MAX_TIME=10
CURL_RETRY_COUNT=3
CURL_RETRY_DELAY=2
CURL_DOWNLOAD_MAX_TIME=60

# TCP/IP チューニング設定
SYSCTL_SOMAXCONN=65535
SYSCTL_TCP_MAX_SYN_BACKLOG=65535
SYSCTL_NETDEV_MAX_BACKLOG=65535
SYSCTL_TCP_TW_REUSE=1
SYSCTL_TCP_FIN_TIMEOUT=15
SYSCTL_RMEM_MAX=16777216
SYSCTL_WMEM_MAX=16777216
SYSCTL_TCP_RMEM="4096 87380 16777216"
SYSCTL_TCP_WMEM="4096 87380 16777216"
SYSCTL_TCP_SYNCOOKIES=1
SYSCTL_GC_THRESH1=4096
SYSCTL_GC_THRESH2=8192
SYSCTL_GC_THRESH3=16384
SYSCTL_NF_CONNTRACK_MAX=1048576
SYSCTL_NF_CONNTRACK_TCP_TIMEOUT_ESTABLISHED=86400
SYSCTL_DIRTY_BACKGROUND_RATIO=5
SYSCTL_DIRTY_RATIO=10
SYSCTL_INOTIFY_MAX_USER_WATCHES=1048576
SYSCTL_INOTIFY_MAX_USER_INSTANCES=16384
SYSCTL_VM_MAX_MAP_COUNT=1048576
SYSCTL_SWAPPINESS=1
SYSCTL_VFS_CACHE_PRESSURE=50
SYSCTL_OVERCOMMIT_MEMORY=1
SYSCTL_IP_LOCAL_PORT_RANGE="10240 65535"
SYSCTL_TCP_KEEPALIVE_TIME=600
SYSCTL_TCP_KEEPALIVE_INTVL=30
SYSCTL_TCP_KEEPALIVE_PROBES=5
SYSCTL_NETDEV_BUDGET=600
SYSCTL_RP_FILTER=2
SYSCTL_AIO_MAX_NR=1048576
SYSCTL_PID_MAX=4194304
SYSCTL_TCP_CONGESTION_CONTROL="bbr"
SYSCTL_DEFAULT_QDISC="fq"
SYSCTL_TCP_FASTOPEN=3

# 動的 swappiness ガバナー
DYNAMIC_SWAPPINESS_ENABLED="true"
DYNAMIC_SWAPPINESS_INTERVAL="60"
DYNAMIC_SWAPPINESS_LOW_LOAD="30"
DYNAMIC_SWAPPINESS_HIGH_LOAD="80"
DYNAMIC_SWAPPINESS_MIN="80"
DYNAMIC_SWAPPINESS_MAX="95"

# Podman チューニング設定
PODMAN_EVENTS_LOGGER="file"
PODMAN_LOG_DRIVER="k8s-file"
PODMAN_LOG_SIZE_MAX="52428800"

# K3s / containerd / Kubelet / CNI チューニング設定
KUBELET_MAX_PODS=250
KUBELET_LOOP_DEVICE_MAX=64
CONTAINERD_MAX_CONCURRENT_DOWNLOADS=10
FLANNEL_BACKEND="host-gw"
KUBE_PROXY_MODE="iptables"

# 単一レプリカ設定
TRAEFIK_REPLICAS=1
WEBHOOK_REPLICAS=1
FLEET_REPLICAS=1
CERT_MANAGER_REPLICAS=1

# メールドメイン
EMAIL_DOMAIN="philippines.com.ph"

# Traefik Dashboard 設定 [Server]
TRAEFIK_HOSTNAME="traefik.${EMAIL_DOMAIN}"
TRAEFIK_ADMIN_USER="admin"
TRAEFIK_ADMIN_PASSWORD="admin"
TRAEFIK_CLIENT_SECRET="traefik-secret"
OAUTH2_PROXY_IMAGE="quay.io/oauth2-proxy/oauth2-proxy:v7.8.1"
OAUTH2_PROXY_REPLICAS=1
OAUTH2_PROXY_COOKIE_SECRET="k3d-traefik-sso-cookie-secret-32"

# 管理者グループ名 (Keycloak, Grafana 共通)
ADMIN_GROUP_NAME="rancher-admins"

# Rancher 設定 [Server]
RANCHER_HOSTNAME="rancher.${EMAIL_DOMAIN}"
RANCHER_REPLICAS=1
RANCHER_ADMIN_PASSWORD="admin12345"
RANCHER_CLIENT_SECRET="rancher-secret"

# Keycloak SSO 設定 [Server]
KEYCLOAK_HOSTNAME="keycloak.${EMAIL_DOMAIN}"
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"
KEYCLOAK_REPLICAS=1
KEYCLOAK_PG_PASSWORD="keycloak-pg-2026"
KEYCLOAK_DB_PASSWORD="keycloak-db-2026"
KEYCLOAK_PG_FIPS="restricted"
KEYCLOAK_PG_SHARED_BUFFERS="512MB"
KEYCLOAK_PG_EFFECTIVE_CACHE_SIZE="1536MB"
KEYCLOAK_PG_WORK_MEM="16MB"
KEYCLOAK_PG_MAINTENANCE_WORK_MEM="128MB"
KEYCLOAK_PG_WAL_BUFFERS="16MB"
KEYCLOAK_PG_CHECKPOINT_COMPLETION_TARGET="0.9"
KEYCLOAK_PG_CHECKPOINT_TIMEOUT="15min"
KEYCLOAK_PG_MIN_WAL_SIZE="1GB"
KEYCLOAK_PG_MAX_WAL_SIZE="4GB"
KEYCLOAK_PG_RANDOM_PAGE_COST="1.1"
KEYCLOAK_PG_EFFECTIVE_IO_CONCURRENCY="200"
KEYCLOAK_PG_DEFAULT_STATISTICS_TARGET="100"
KEYCLOAK_PG_MAX_WORKER_PROCESSES=8
KEYCLOAK_PG_MAX_PARALLEL_WORKERS=4
KEYCLOAK_PG_MAX_PARALLEL_WORKERS_PER_GATHER=2
KEYCLOAK_PG_MAX_PARALLEL_MAINTENANCE_WORKERS=2
KEYCLOAK_PG_LOG_MIN_DURATION_STATEMENT=1000
KEYCLOAK_PG_LOGGING_COLLECTOR=true
KEYCLOAK_PG_LOG_DESTINATION="csvlog,stderr"
KEYCLOAK_PG_LOG_DIRECTORY="log"
KEYCLOAK_PG_LOG_FILENAME="postgresql-%Y-%m-%d_%H%M%S.log"
KEYCLOAK_PG_LOG_ROTATION_AGE="1d"
KEYCLOAK_PG_LOG_ROTATION_SIZE="100MB"
KEYCLOAK_PG_LOG_MIN_MESSAGES="warning"
KEYCLOAK_PG_LOG_LINE_PREFIX="%m [%p] %q%u@%d "
KEYCLOAK_PG_TIMEZONE="Asia/Tokyo"
KEYCLOAK_PG_LOG_TIMEZONE="Asia/Tokyo"
KEYCLOAK_PG_METRICS_ENABLED=true
KEYCLOAK_PG_REPLICA_COUNT=1
KEYCLOAK_PG_MAX_CONNECTIONS="200"
KEYCLOAK_PG_STORAGE_CLASS="local-path"
KEYCLOAK_PG_STORAGE_SIZE="10Gi"
KEYCLOAK_PG_HOST="keycloak-pg-postgresql"
KEYCLOAK_PG_PRIMARY_POD="keycloak-pg-postgresql-0"
KEYCLOAK_EVENTS_ENABLED=true
KEYCLOAK_EVENTS_EXPIRATION=2592000
KEYCLOAK_ADMIN_EVENTS_ENABLED=true
KEYCLOAK_ADMIN_EVENTS_DETAILS=true

# Grafana 監視ダッシュボード設定 [Server]
GRAFANA_HOSTNAME="grafana.${EMAIL_DOMAIN}"
GRAFANA_ADMIN_PASSWORD="admin"
GRAFANA_CLIENT_SECRET="grafana-secret"
GRAFANA_REPLICAS=1
GRAFANA_DB_PASSWORD="grafana-db-2026"
GRAFANA_DB_MAX_OPEN_CONN=20
GRAFANA_DB_MAX_IDLE_CONN=10

# Prometheus 監視設定 [Server]
PROMETHEUS_REPLICAS=1
ALERTMANAGER_REPLICAS=1
MONITORING_PROXY_REPLICAS=1
PROMETHEUS_RETENTION="7d"
PROMETHEUS_SCRAPE_INTERVAL="30s"
PROMETHEUS_EVALUATION_INTERVAL="60s"
PROMETHEUS_CPU_LIMIT="4000m"
PROMETHEUS_MEMORY_LIMIT="4Gi"
PROMETHEUS_CPU_REQUEST="500m"
PROMETHEUS_MEMORY_REQUEST="1Gi"

# pgAdmin 4 設定 [Server]
PGADMIN_HOSTNAME="pgadmin.${EMAIL_DOMAIN}"
PGADMIN_ADMIN_EMAIL="admin@${EMAIL_DOMAIN}"
PGADMIN_ADMIN_PASSWORD="admin"
PGADMIN_REPLICAS=1
PGADMIN_CLIENT_SECRET="pgadmin-secret"
PGADMIN_LOG_LEVEL="DEBUG"
PGADMIN_STATIC_CRYPT_KEY="k3d-pgadmin-master-key-2026"

# AMD GPU Device Plugin 設定 [Worker]
AMD_GPU_PLUGIN_ENABLED=true
AMD_GPU_NODE_SELECTOR_ENABLED=true
KFD_DEVICE_PATH="/dev/kfd"
DRI_DEVICE_PATH="/dev/dri"

# AMD NPU (XDNA) Device Plugin 設定 [Worker]
AMD_NPU_PLUGIN_ENABLED=true
ACCEL_DEVICE_PATH="/dev/accel"
AMD_NPU_DEVICE_PLUGIN_IMAGE="docker.io/squat/generic-device-plugin:latest"
AMD_NPU_RESOURCE_DOMAIN="amd.com"
AMD_NPU_DEVICE_NAME="npu"
AMD_NPU_DEVICE_COUNT=1
AMD_NPU_EXPORTER_ENABLED=true
AMD_NPU_EXPORTER_PORT=9105
AMD_NPU_POWER_MODE="TURBO" # 0=DEFAULT, 1=LOW, 2=MED, 3=HIGH, 4=TURBO


# Lemonade Server (GPU LLM / Ollama 互換 API) 設定 [Worker]
LEMONADE_ENABLED=true
LEMONADE_NAMESPACE="lemonade"
LEMONADE_HOSTNAME="lemonade.${EMAIL_DOMAIN}"
LEMONADE_PORT=11434
LEMONADE_REPLICAS=1
LEMONADE_BACKEND="rocm"
LEMONADE_GPU_ENABLED=true
LEMONADE_GPU_NUMBER=1
LEMONADE_STORAGE_SIZE="30Gi"
LEMONADE_STORAGE_CLASS="local-path"
LEMONADE_CPU_REQUEST="500m"
LEMONADE_MEMORY_REQUEST="2Gi"
LEMONADE_MEMORY_LIMIT="48Gi"
LEMONADE_PROBE_PATH="/live"
LEMONADE_CTX_SIZE=8192
LEMONADE_LIVENESS_DELAY_SECONDS=60
LEMONADE_LIVENESS_TIMEOUT_SECONDS=5
LEMONADE_LIVENESS_FAILURE_THRESHOLD=40
LEMONADE_LIVENESS_PERIOD_SECONDS=15
LEMONADE_READINESS_DELAY_SECONDS=30
LEMONADE_READINESS_TIMEOUT_SECONDS=5
LEMONADE_READINESS_FAILURE_THRESHOLD=3
LEMONADE_READINESS_PERIOD_SECONDS=10
# 標準 LLM モデル (start.sh 末尾で自動登録 & Open WebUI 標準モデルに設定)
LEMONADE_DEFAULT_MODEL="Qwen3.8-27B-GGUF"
LEMONADE_DEFAULT_MODEL_AUTO_SETUP=true
LEMONADE_DEFAULT_MODEL_SETUP_RETRIES=30
LEMONADE_DEFAULT_MODEL_SETUP_RETRY_INTERVAL=2
LEMONADE_PULL_RETRIES=10
LEMONADE_PULL_RETRY_INTERVAL=10

# AMD NPU 推論エンジン (FastFlowLM) 設定 [Worker/Host]
NPU_FLM_ENABLED=true
NPU_FLM_PORT=52625
NPU_FLM_DEFAULT_MODEL="gemma4-it:e4b"
NPU_FLM_HOST_IP="10.89.0.1"
NPU_FLM_BIND_HOST="0.0.0.0"
NPU_FLM_PROBE_HOST="127.0.0.1"
NPU_FLM_PROBE_PATH="/v1/models"
NPU_FLM_STARTUP_RETRIES=15
NPU_FLM_STARTUP_RETRY_INTERVAL=1
NPU_FLM_KERNEL_DIR="/opt/fastflowlm/lib"

# Open WebUI (Local AI Web チャット基盤) 設定 [Worker]
OPEN_WEBUI_ENABLED=true
OPEN_WEBUI_NAMESPACE="open-webui"
OPEN_WEBUI_HOSTNAME="chat.${EMAIL_DOMAIN}"
OPEN_WEBUI_PORT=8080
OPEN_WEBUI_REPLICAS=1
OPEN_WEBUI_CLIENT_ID="open-webui"
OPEN_WEBUI_CLIENT_SECRET="open-webui-secret"
OPEN_WEBUI_STORAGE_SIZE="30Gi"
OPEN_WEBUI_STORAGE_CLASS="local-path"
OPEN_WEBUI_DEFAULT_LOCALE="ja-JP"
OPEN_WEBUI_DEFAULT_SYSTEM_PROMPT="あなたは親切で極めて有能なAIアシスタントです。
以下のルールを遵守して回答してください：
1. 回答は常に自然で丁寧かつ正確な日本語で行ってください。
2. 技術用語や固有名詞（プログラミング言語、CLIコマンド、ライブラリ名など）は無理に翻訳せず、正確な公式表記を保持してください。
3. ソースコードやコマンドを提示する際は、適切なコードブロック（Markdown）を用いて可読性を高く保ってください。
4. 不確かな情報や推測に基づく内容は断定せず、確認が必要である旨を明記してください。"
OPEN_WEBUI_CPU_REQUEST="250m"
OPEN_WEBUI_MEMORY_REQUEST="512Mi"
OPEN_WEBUI_MEMORY_LIMIT="4Gi"
OPEN_WEBUI_ROLLOUT_TIMEOUT="300s"
OPEN_WEBUI_WEB_SEARCH_ENABLED=true
OPEN_WEBUI_WEB_SEARCH_ENGINE="duckduckgo"
OPEN_WEBUI_WEB_SEARCH_RESULT_COUNT=3
OPEN_WEBUI_WEB_SEARCH_CONCURRENT_REQUESTS=10
OPEN_WEBUI_WEB_SEARCH_BYPASS_WEB_LOADER=true
OPEN_WEBUI_WEB_SEARCH_BYPASS_EMBEDDING_AND_RETRIEVAL=true
OPEN_WEBUI_CORS_ALLOW_ORIGIN="https://${OPEN_WEBUI_HOSTNAME}"
OPEN_WEBUI_DB_TYPE="postgres"
OPEN_WEBUI_PG_DATABASE="openwebui"
OPEN_WEBUI_PG_USER="openwebui"
OPEN_WEBUI_PG_PASSWORD="openwebui-db-2026"
OPEN_WEBUI_GOOGLE_DRIVE_INTEGRATION_ENABLED=true
OPEN_WEBUI_GOOGLE_DRIVE_CLIENT_ID="601398947241-ql3ofoooe7ousm1qejth6hg171l7q67t.apps.googleusercontent.com"
OPEN_WEBUI_GOOGLE_DRIVE_API_KEY="AIzaSyBIFb3bNIm-oxkgi6pppoJhqbAs0LzihjU"

# ネットワーク・CIDR・IP 設定
PODMAN_NETWORK_CIDR="10.89.0.0/24"
PODMAN_NETWORK_GATEWAY="10.89.0.1"
CLUSTER_DNS_IP="127.0.0.1"
K8S_SERVICE_CIDR="10.43.0.0/16"
K8S_CLUSTER_CIDR="10.42.0.0/16"
K8S_NODE_CIDR_MASK_SIZE=24

# 主要ポート番号設定
K8S_API_PORT=6443
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_CONTAINER_HTTP_PORT=8000
TRAEFIK_CONTAINER_HTTPS_PORT=8443
TRAEFIK_ADMIN_PORT=8080
TRAEFIK_PING_PORT=9000
TRAEFIK_METRICS_PORT=9100
POSTGRES_PORT=5432
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
OAUTH2_PROXY_PORT=4180
LEMONADE_PORT=11434
