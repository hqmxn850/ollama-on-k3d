---
# ==========================================================
# PostgreSQL (Keycloak Backend) Private Protection NetworkPolicy
# ==========================================================
# 外部および認可外の名前空間からのアクセスを遮断し、
# Keycloak アプリケーションおよび Grafana のみを許可

apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: postgresql-private-isolation
  namespace: {{ keycloak_namespace | default('keycloak') }}
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: postgresql
  policyTypes:
    - Ingress
    - Egress
  ingress:
    # 1. 同一名前空間内の通信 (Keycloak Pod からの接続)
    - from:
        - podSelector: {}
      ports:
        - protocol: TCP
          port: {{ postgres_port | default(5432) }}

    # 2. Grafana からの PostgreSQL データソース接続 (ポート {{ postgres_port | default(5432) }})
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ monitoring_namespace | default('cattle-monitoring-system') }}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: grafana
      ports:
        - protocol: TCP
          port: {{ postgres_port | default(5432) }}

    # 3. Prometheus からの postgres-exporter メトリクス収集 (ポート {{ postgres_exporter_port | default(9187) }})
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ monitoring_namespace | default('cattle-monitoring-system') }}
      ports:
        - protocol: TCP
          port: {{ postgres_exporter_port | default(9187) }}

    # 4. Open WebUI からの PostgreSQL バックエンド接続 (ポート {{ postgres_port | default(5432) }})
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ open_webui_namespace | default('open-webui') }}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: open-webui
      ports:
        - protocol: TCP
          port: {{ postgres_port | default(5432) }}

  egress:
    # 1. 同一名前空間内の通信
    - to:
        - podSelector: {}

    # 2. CoreDNS への名前解決 (kube-system)
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ kube_system_namespace | default('kube-system') }}
      ports:
        - protocol: UDP
          port: {{ dns_port | default(53) }}
        - protocol: TCP
          port: {{ dns_port | default(53) }}
