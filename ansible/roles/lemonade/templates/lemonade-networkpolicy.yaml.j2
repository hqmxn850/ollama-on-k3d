---
# ==========================================================
# Application Plane Protection NetworkPolicy: Lemonade (lemonade)
# ==========================================================
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: lemonade-app-protection
  namespace: {{ lemonade_namespace | default('lemonade') }}
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
  ingress:
    # 1. 同一名前空間内の通信
    - from:
        - podSelector: {}

    # 2. Traefik Ingress (kube-system) からの Lemonade API アクセス
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ kube_system_namespace | default('kube-system') }}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: traefik
      ports:
        - protocol: TCP
          port: {{ lemonade_port | default(11434) }}

    # 3. Open WebUI 名前空間からの推論 API アクセス
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ open_webui_namespace | default('open-webui') }}
      ports:
        - protocol: TCP
          port: {{ lemonade_port | default(11434) }}

    # 4. Prometheus 監視基盤からのメトリクススクレイプ許可 (/metrics)
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ monitoring_namespace | default('cattle-monitoring-system') }}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: prometheus
      ports:
        - protocol: TCP
          port: {{ lemonade_port | default(11434) }}

  egress:
    # 1. DNS 名前解決 (CoreDNS)
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ kube_system_namespace | default('kube-system') }}
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53

    # 2. 同一名前空間内の通信
    - to:
        - podSelector: {}

    # 3. 外部モデルダウンロード・ROCm バックエンド取得 (HuggingFace / GitHub 等)
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
            except:
              - {{ podman_network_cidr | default('10.89.0.0/24') }}
      ports:
        - protocol: TCP
          port: {{ http_port | default(80) }}
        - protocol: TCP
          port: {{ https_port | default(443) }}
