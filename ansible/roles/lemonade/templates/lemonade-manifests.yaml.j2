---
# ==============================================================================
# Lemonade Server Kubernetes Manifests
# リテラルは ansible/group_vars/all.yml (Single Source of Truth) を参照
# ==============================================================================

# 1. PVC (モデル / キャッシュ永続ストレージ / storageClassName: {{ lemonade_storage_class | default('local-path') }})
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: lemonade-data
  namespace: {{ lemonade_namespace | default('lemonade') }}
  labels:
    app.kubernetes.io/name: lemonade
    app.kubernetes.io/instance: lemonade
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ lemonade_storage_class | default('local-path') | quote }}
  resources:
    requests:
      storage: {{ lemonade_storage_size | default('30Gi') | quote }}

---
# 2. Deployment (Ollama 互換 API + OpenAI 互換 API / AMD GPU ROCm 推論)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: lemonade
  namespace: {{ lemonade_namespace | default('lemonade') }}
  labels:
    app.kubernetes.io/name: lemonade
    app.kubernetes.io/instance: lemonade
spec:
  replicas: {{ lemonade_replicas | default(1) }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: lemonade
      app.kubernetes.io/instance: lemonade
  template:
    metadata:
      labels:
        app.kubernetes.io/name: lemonade
        app.kubernetes.io/instance: lemonade
      annotations:
        # バックエンド設定 (llamacpp.backend) 変更時に Pod を再作成して設定を反映する
        checksum/lemonade-backend: {{ (lemonade_backend | default('rocm')) | hash('sha256') }}
    spec:
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      initContainers:
        # local-path PVC (root 所有) の所有権を非 root 実行ユーザーへ移し、
        # バックエンド設定 config.json を書き出してから本体を起動する
        - name: lemonade-init
          image: {{ lemonade_image | default('ghcr.io/lemonade-sdk/lemonade-server:latest') | quote }}
          imagePullPolicy: IfNotPresent
          securityContext:
            runAsUser: 0
            runAsGroup: 0
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -e
              mkdir -p /opt/lemonade/.cache/lemonade /opt/lemonade/llama /opt/lemonade/.config/lemonade
              chown -R 10001:10001 /opt/lemonade/.cache/lemonade /opt/lemonade/llama /opt/lemonade/.config/lemonade
              printf '%s\n' '{{ {"llamacpp": {"backend": lemonade_backend | default("rocm")}} | to_json }}' > /opt/lemonade/.config/lemonade/config.json
              chown 10001:10001 /opt/lemonade/.config/lemonade/config.json
          volumeMounts:
            - name: lemonade-data
              mountPath: /opt/lemonade/.cache
              subPath: cache
            - name: lemonade-data
              mountPath: /opt/lemonade/llama
              subPath: llama
            - name: lemonade-data
              mountPath: /opt/lemonade/.config/lemonade
              subPath: config
      containers:
        - name: lemonade
          image: {{ lemonade_image | default('ghcr.io/lemonade-sdk/lemonade-server:latest') | quote }}
          imagePullPolicy: IfNotPresent
          command: ["/opt/lemonade/lemond"]
          args:
            - "--host"
            - "0.0.0.0"
            - "--port"
            - "{{ lemonade_port | default(11434) }}"
          ports:
            - name: http
              containerPort: {{ lemonade_port | default(11434) }}
              protocol: TCP
          resources:
            requests:
              cpu: {{ lemonade_cpu_request | default('500m') | quote }}
              memory: {{ lemonade_memory_request | default('2Gi') | quote }}
{% if lemonade_gpu_enabled | default(true) | bool %}
              {{ amd_gpu_resource_domain | default('amd.com') }}/{{ amd_gpu_device_name | default('gpu') }}: {{ lemonade_gpu_number | default(1) }}
{% endif %}
            limits:
              memory: {{ lemonade_memory_limit | default('16Gi') | quote }}
{% if lemonade_gpu_enabled | default(true) | bool %}
              {{ amd_gpu_resource_domain | default('amd.com') }}/{{ amd_gpu_device_name | default('gpu') }}: {{ lemonade_gpu_number | default(1) }}
{% endif %}
          livenessProbe:
            httpGet:
              path: {{ lemonade_probe_path | default('/live') | quote }}
              port: http
            initialDelaySeconds: {{ lemonade_liveness_delay_seconds | default(60) }}
            periodSeconds: {{ lemonade_liveness_period_seconds | default(15) }}
            timeoutSeconds: {{ lemonade_liveness_timeout_seconds | default(5) }}
            failureThreshold: {{ lemonade_liveness_failure_threshold | default(6) }}
          readinessProbe:
            httpGet:
              path: {{ lemonade_probe_path | default('/live') | quote }}
              port: http
            initialDelaySeconds: {{ lemonade_readiness_delay_seconds | default(30) }}
            periodSeconds: {{ lemonade_readiness_period_seconds | default(10) }}
            timeoutSeconds: {{ lemonade_readiness_timeout_seconds | default(5) }}
            failureThreshold: {{ lemonade_readiness_failure_threshold | default(3) }}
          volumeMounts:
            - name: lemonade-data
              mountPath: /opt/lemonade/.cache
              subPath: cache
            - name: lemonade-data
              mountPath: /opt/lemonade/llama
              subPath: llama
            - name: lemonade-data
              mountPath: /opt/lemonade/.config/lemonade
              subPath: config
      volumes:
        - name: lemonade-data
          persistentVolumeClaim:
            claimName: lemonade-data

---
# 3. Service (Ollama 互換 / OpenAI 互換 API + Prometheus メトリクス)
apiVersion: v1
kind: Service
metadata:
  name: lemonade
  namespace: {{ lemonade_namespace | default('lemonade') }}
  labels:
    app.kubernetes.io/name: lemonade
    app.kubernetes.io/instance: lemonade
spec:
  type: ClusterIP
  ports:
    - name: http
      port: {{ lemonade_port | default(11434) }}
      targetPort: http
      protocol: TCP
  selector:
    app.kubernetes.io/name: lemonade
    app.kubernetes.io/instance: lemonade

---
# 4. Ingress (公開 Ollama 互換 API / Traefik + cert-manager)
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: lemonade
  namespace: {{ lemonade_namespace | default('lemonade') }}
  labels:
    app.kubernetes.io/name: lemonade
  annotations:
    cert-manager.io/cluster-issuer: "{{ cluster_issuer_name | default('internal-ca-issuer') }}"
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  ingressClassName: traefik
  tls:
    - secretName: lemonade-tls
      hosts:
        - {{ lemonade_hostname }}
  rules:
    - host: {{ lemonade_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: lemonade
                port:
                  number: {{ lemonade_port | default(11434) }}
