# ==============================================================================
# Open WebUI Helm Values Template
# リテラルは ansible/group_vars/all.yml (Single Source of Truth) を参照
# ==============================================================================

nameOverride: "open-webui"
fullnameOverride: "open-webui"

# 標組み Ollama サービスは利用しない (Ollama 互換 API はクラスタ内の Lemonade が提供)
ollama:
  enabled: false

# クラスタ内 Lemonade (Ollama 互換 API) エンドポイント
# FQDN = Service 名 (lemonade_service_name) + 名前空間 (lemonade_namespace)
ollamaUrls:
  - "http://{{ lemonade_service_name | default('lemonade') }}.{{ lemonade_namespace | default('lemonade') }}.svc.cluster.local:{{ lemonade_port | default(11434) }}"

# Pipelines, Tika, Terminals は不要のため無効化
pipelines:
  enabled: false

tika:
  enabled: false

terminals:
  enabled: false

# WebSocket サポートを無効化 (Redis を導入しない単一レプリカ構成)
websocket:
  enabled: false

image:
  repository: {{ open_webui_image_repository | default('ghcr.io/open-webui/open-webui') | quote }}
  tag: {{ open_webui_image_tag | default('v0.11.4') | quote }}
  pullPolicy: IfNotPresent

# Local Path PVC ストレージ永続化
persistence:
  enabled: true
  size: {{ open_webui_storage_size | default('30Gi') | quote }}
  storageClass: {{ open_webui_storage_class | default('local-path') | quote }}
  accessModes:
    - ReadWriteOnce

nodeSelector:
  node-role.kubernetes.io/worker: "true"

# Traefik Ingress + cert-manager TLS
ingress:
  enabled: true
  class: "traefik"
  annotations:
    cert-manager.io/cluster-issuer: "{{ cluster_issuer_name | default('internal-ca-issuer') }}"
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
  host: {{ open_webui_hostname | quote }}
  tls: true
  existingSecret: "open-webui-tls"

# リソース割り当て
resources:
  requests:
    cpu: {{ open_webui_cpu_request | default('250m') | quote }}
    memory: {{ open_webui_memory_request | default('512Mi') | quote }}
  limits:
    memory: {{ open_webui_memory_limit | default('4Gi') | quote }}

# Keycloak OIDC SSO 連携 & バックエンド環境変数
extraEnvVars:
  # ベース URL & アプリケーション設定
  - name: WEBUI_URL
    value: "https://{{ open_webui_hostname }}"
  - name: CORS_ALLOW_ORIGIN
    value: {{ open_webui_cors_allow_origin | default('https://' ~ open_webui_hostname) | quote }}
  - name: WEBUI_NAME
    value: "Open WebUI (Local AI)"
  - name: DEFAULT_LOCALE
    value: {{ open_webui_default_locale | default('ja-JP') | quote }}
  - name: DEFAULT_INTERFACE_SETTINGS
    value: '{"locale": {{ open_webui_default_locale | default("ja-JP") | to_json }}}'
{% if open_webui_database_url | default('') | length > 0 %}
  - name: DATABASE_URL
    value: {{ open_webui_database_url | quote }}
{% endif %}
  - name: WEBUI_AUTH
    value: "true"
  # Keycloak OIDC 認証設定
  - name: ENABLE_OAUTH_SIGNUP
    value: "true"
  - name: OAUTH_CLIENT_ID
    value: {{ open_webui_client_id | default('open-webui') | quote }}
  - name: OAUTH_CLIENT_SECRET
    value: {{ open_webui_client_secret | quote }}
  - name: OPENID_PROVIDER_URL
    value: "http://keycloak-keycloak.{{ keycloak_namespace | default('keycloak') }}.svc.cluster.local:{{ keycloak_http_port | default(8080) }}/realms/{{ keycloak_realm | default('master') }}/.well-known/openid-configuration"
  - name: OPENID_REDIRECT_URI
    value: "https://{{ open_webui_hostname }}/oauth/oidc/callback"
  - name: OAUTH_PROVIDER_NAME
    value: "Keycloak"
  - name: OAUTH_SCOPES
    value: "openid email profile"
  - name: OAUTH_MERGE_ACCOUNTS_BY_EMAIL
    value: "true"
  - name: ENABLE_OAUTH_PERSISTENT_CONFIG
    value: "false"
  # ホスト FastFlowLM (AMD XDNA NPU) OpenAI 互換 API 直接連携
  - name: OPENAI_API_BASE_URLS
    value: "{{ 'http://' ~ npu_flm_host_ip ~ ':' ~ npu_flm_port ~ '/v1' if (npu_flm_enabled | default(true) | bool) else '' }}"
  - name: OPENAI_API_KEYS
    value: "none"
  # Pipe 系 Function (multi_model_conversations / planner_agent) 用設定
  # クラスタ内 Lemonade Service FQDN = Service 名.名前空間.svc.cluster.local
  - name: LEMONADE_API_URL
    value: "http://{{ lemonade_service_name | default('lemonade') }}.{{ lemonade_namespace | default('lemonade') }}.svc.cluster.local:{{ lemonade_port | default(11434) }}"
  # 標準モデル (Lemonade / GPU) — planner の default_model と multi_model の MODELS に反映
  - name: PIPE_DEFAULT_MODEL
    value: {{ lemonade_default_model | default('Gemma-4-E4B-it-GGUF') | quote }}
  - name: PIPE_DEFAULT_MODELS
    value: {{ (lemonade_default_model | default('Gemma-4-E4B-it-GGUF') ~ (', ' ~ (npu_flm_default_model | default('gemma4-it:e4b')) if (npu_flm_enabled | default(true) | bool) else '')) | quote }}
{% if npu_flm_enabled | default(true) | bool %}
  # NPU (FastFlowLM) へルーティングするモデル ID
  - name: NPU_MODEL_IDS
    value: {{ npu_flm_default_model | default('gemma4-it:e4b') | quote }}
{% endif %}
  # Web 検索 (RAG Web Search) 設定
  - name: ENABLE_WEB_SEARCH
    value: "{{ open_webui_web_search_enabled | default(true) | string | lower }}"
  - name: WEB_SEARCH_ENGINE
    value: {{ open_webui_web_search_engine | default('duckduckgo') | quote }}
  - name: WEB_SEARCH_RESULT_COUNT
    value: "{{ open_webui_web_search_result_count | default(3) | string }}"
  - name: WEB_SEARCH_CONCURRENT_REQUESTS
    value: "{{ open_webui_web_search_concurrent_requests | default(10) | string }}"
  - name: BYPASS_WEB_SEARCH_WEB_LOADER
    value: "{{ open_webui_web_search_bypass_web_loader | default(true) | string | lower }}"
  - name: BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL
    value: "{{ open_webui_web_search_bypass_embedding_and_retrieval | default(true) | string | lower }}"
  - name: DDGS_BACKEND
    value: "auto"
{% if open_webui_google_drive_integration_enabled | default(false) | bool %}
  # Google Drive 連携設定
  - name: ENABLE_GOOGLE_DRIVE_INTEGRATION
    value: "true"
  - name: GOOGLE_DRIVE_CLIENT_ID
    value: {{ open_webui_google_drive_client_id | default('') | quote }}
  - name: GOOGLE_DRIVE_API_KEY
    value: {{ open_webui_google_drive_api_key | default('') | quote }}
{% endif %}

# コンテナ起動時ラッパースクリプト (Web 検索・Function Calling 連携パッチの起動前自動適用)
command:
  - /bin/bash
  - /app/entrypoint.sh

# フロントエンド静的スクリプト (loader.js) による初回アクセス時のロケール自動適用 & エントリポイント
volumeMounts:
  container:
    - name: open-webui-entrypoint
      mountPath: /app/entrypoint.sh
      subPath: entrypoint.sh
    - name: open-webui-loader-js
      mountPath: /app/build/static/loader.js
      subPath: loader.js

volumes:
  - name: open-webui-entrypoint
    configMap:
      name: open-webui-entrypoint
      defaultMode: 0755
  - name: open-webui-loader-js
    configMap:
      name: open-webui-loader-js
      defaultMode: 0644

extraResources:
  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: open-webui-entrypoint
      labels:
        app.kubernetes.io/name: open-webui
        app.kubernetes.io/component: open-webui
    data:
      entrypoint.sh: |
        #!/usr/bin/env bash
        set -e
        # Open WebUI 起動前パッチ: Web 検索 (RAG DuckDuckGo) および Tool 連携の最適化
        python3 - << 'PYEOF'
        import os

        try:
            mw_path = "/app/backend/open_webui/utils/middleware.py"
            if os.path.exists(mw_path):
                with open(mw_path, "r", encoding="utf-8") as f:
                    content = f.read()
                changed = False

                # 1. Native FC 有効時でも RAG Web 検索を実行するようパッチ
                # (Qwen 等のローカル LLM が自律 Tool Call をスキップして『情報を持っていません』と答えるのを防止)
                target_rag = """                # Skip forced RAG web search when native FC is enabled - model can use web_search tool
                        if metadata.get('params', {}).get('function_calling') == 'legacy':
                            form_data = await chat_web_search_handler(request, form_data, extra_params, user)"""
                repl_rag = """                # Execute RAG web search when web_search feature is requested (even if native FC enabled)
                        form_data = await chat_web_search_handler(request, form_data, extra_params, user)"""
                if target_rag in content:
                    content = content.replace(target_rag, repl_rag)
                    changed = True

                # 2. features に web_search が明示されていない場合、グローバル設定が有効なら自動補完
                mw_target1 = "    features = form_data.pop('features', None) or {}\n    extra_params['__features__'] = features"
                mw_repl1 = "    features = form_data.pop('features', None) or {}\n    if 'web_search' not in features and await Config.get('web.search.enable'):\n        features['web_search'] = True\n    extra_params['__features__'] = features"
                if mw_target1 in content:
                    content = content.replace(mw_target1, mw_repl1)
                    changed = True

                # 3. モデルメタデータから toolIds を自動継承
                mw_target2 = "        # Server side tools\n        tool_ids = metadata.get('tool_ids', None)"
                mw_repl2 = "        # Server side tools\n        tool_ids = metadata.get('tool_ids', None)\n        if not tool_ids and task_model_id in models:\n            tool_ids = list(models[task_model_id].get('info', {}).get('meta', {}).get('toolIds') or [])"
                if mw_target2 in content:
                    content = content.replace(mw_target2, mw_repl2)
                    changed = True

                if changed:
                    with open(mw_path, "w", encoding="utf-8") as f:
                        f.write(content)
                    print("Successfully patched Open WebUI middleware.py at container startup")
                else:
                    print("Open WebUI middleware.py already up-to-date")
        except Exception as e:
            print(f"Warning: Failed to patch middleware.py at startup: {e}")

        # 4. フロントエンドの地球儀アイコン (Web 検索) のデフォルト ON パッチ
        try:
            import glob
            for f in glob.glob('/app/build/_app/immutable/chunks/*.js'):
                with open(f, 'r', encoding='utf-8') as js_f:
                    js_c = js_f.read()
                if 'q.webSearchEnabled??!1' in js_c:
                    js_c = js_c.replace('q.webSearchEnabled??!1', 'q.webSearchEnabled??!0')
                    with open(f, 'w', encoding='utf-8') as js_f:
                        js_f.write(js_c)
                    print(f"Successfully patched webSearchEnabled default to true in {os.path.basename(f)}")
        except Exception as e:
            print(f"Warning: Failed to patch frontend webSearchEnabled in entrypoint: {e}")

        # 5. index.html の lang 属性と loader.js 同期読み込みパッチ
        try:
            import re
            html_path = "/app/build/index.html"
            if os.path.exists(html_path):
                with open(html_path, "r", encoding="utf-8") as f:
                    content = f.read()
                content = re.sub(r'<html lang="[^"]*"', '<html lang="{{ open_webui_default_locale | default("ja-JP") }}"', content)
                content = content.replace('src="/static/loader.js" defer', 'src="/static/loader.js"')
                with open(html_path, "w", encoding="utf-8") as f:
                    f.write(content)
                print("Successfully patched index.html language and loader in entrypoint")
        except Exception as e:
            print(f"Warning: Failed to patch index.html in entrypoint: {e}")

        # 6. フロントエンド SvelteKit 初期化ロケール自動強制同期パッチ (英語フォールバック回避)
        try:
            import glob
            files = glob.glob("/app/build/_app/immutable/nodes/0.*.js")
            target = '!localStorage.locale){const f=await po(),_=navigator.languages?navigator.languages:[navigator.language||navigator.userLanguage],te=J!=null&&J.default_locale?J.default_locale:So(f,_,"en-US");await ho(te),Io.locale(te)}'
            repl = '(!localStorage.locale||localStorage.locale==="en-US"||localStorage.locale==="en"||localStorage.locale==="{{ open_webui_default_locale | default("ja-JP") }}")){const f=await po(),_=navigator.languages?navigator.languages:[navigator.language||navigator.userLanguage],te=J!=null&&J.default_locale?J.default_locale:"{{ open_webui_default_locale | default("ja-JP") }}";localStorage.setItem("locale",te);await ho(te),Io.locale(te)}'
            for f in files:
                with open(f, "r", encoding="utf-8") as fp:
                    c = fp.read()
                if target in c:
                    c = c.replace(target, repl)
                    with open(f, "w", encoding="utf-8") as fp:
                        fp.write(c)
                    print(f"Successfully patched frontend locale enforcement in {os.path.basename(f)}")
        except Exception as e:
            print(f"Warning: Failed to patch frontend locale in entrypoint: {e}")

        # 7. プロンプト提案 (Prompt Suggestions) の日本語翻訳パッチ (空文字列フォールバック防止)
        try:
            import glob, json
            suggestions_translations = {
                'Help me study': '学習をサポート',
                'vocabulary for a college entrance exam': '語彙力や資格試験の勉強',
                'Help me study vocabulary: write a sentence for me to fill in the blank, and I\'ll try to pick the correct option.': '語彙力向上のための練習をしたいです。文脈に合った単語を選ぶ穴埋め問題を1問出題してください。',
                'Give me ideas': 'アイデアを出す',
                'for what to do with my kids\' art': '子どもの工作や作品の活用法',
                'What are 5 creative things I could do with my kids\' art? I don\'t want to throw them away, but it\'s also so much clutter.': '子どもの作品を活用するクリエイティブなアイデアを5つ提案してください。捨てるのは避けたいですが、場所を取って困っています。',
                'Tell me a fun fact': '面白い豆知識',
                'about the Roman Empire': '古代ローマ帝国について',
                'Tell me a random fun fact about the Roman Empire': '古代ローマ帝国に関する、あまり知られていない興味深く面白い豆知識を1つ教えてください。',
                'Show me a code snippet': 'コードスニペットを表示',
                'of a website\'s sticky header': 'Webサイトの固定ヘッダー',
                'Show me a code snippet of a website\'s sticky header in CSS and JavaScript.': 'CSSとJavaScriptを使用したWebサイトの固定ヘッダー（Sticky Header）の実装コード例を提示してください。',
                'Explain options trading': 'オプション取引を解説',
                'if I\'m familiar with buying and selling stocks': '株式投資の経験者向けに',
                'Explain options trading in simple terms if I\'m familiar with buying and selling stocks.': '株式の現物売買の経験がある人向けに、オプション取引の基本概念と仕組みを分かりやすく簡潔に解説してください。',
                'Overcome procrastination': '先延ばし癖を克服',
                'give me tips': 'アドバイスを提示',
                'Could you start by asking me about instances when I procrastinate the most and then give me some suggestions to overcome it?': '私がどのような時に先延ばしにしがちか質問して、その上で克服するための具体的なアドバイスを提案してください。'
            }
            for f in glob.glob('/app/build/_app/immutable/chunks/*.js'):
                with open(f, 'r', encoding='utf-8') as fp:
                    c = fp.read()
                if '"Help me study":""' in c:
                    for k, v in suggestions_translations.items():
                        target = f'"{k}":""'
                        repl = f'"{k}":{json.dumps(v, ensure_ascii=False)}'
                        if target in c:
                            c = c.replace(target, repl)
                    with open(f, 'w', encoding='utf-8') as fp:
                        fp.write(c)
                    print(f"Successfully patched Japanese prompt suggestions in {os.path.basename(f)}")
        except Exception as e:
            print(f"Warning: Failed to patch prompt suggestions in entrypoint: {e}")

        # 8. ツールの ON / OFF 状態の localStorage 記憶 & 新規チャットへの自動継承パッチ
        try:
            import glob
            get_tool_ids = 'JSON.parse(localStorage.getItem("selectedToolIds")||"[]")'
            for f in glob.glob('/app/build/_app/immutable/chunks/*.js'):
                with open(f, 'r', encoding='utf-8') as fp:
                    c = fp.read()
                changed = False
                if 'let Ht=I([])' in c:
                    c = c.replace('let Ht=I([])', 'let Ht=I(' + get_tool_ids + ')', 1)
                    changed = True
                s_nt = 'set selectedToolIds(Nt)' + chr(123) + 'c(Ht,Nt)' + chr(125)
                r_nt = 'set selectedToolIds(Nt)' + chr(123) + 'c(Ht,Nt),localStorage.setItem("selectedToolIds",JSON.stringify(Nt))' + chr(125)
                if s_nt in c:
                    c = c.replace(s_nt, r_nt)
                    changed = True
                s_ft = 'set selectedToolIds(Ft)' + chr(123) + 'c(Ht,Ft)' + chr(125)
                r_ft = 'set selectedToolIds(Ft)' + chr(123) + 'c(Ht,Ft),localStorage.setItem("selectedToolIds",JSON.stringify(Ft))' + chr(125)
                if s_ft in c:
                    c = c.replace(s_ft, r_ft)
                    changed = True
                s_mt = 'set selectedToolIds(mt)' + chr(123) + 'c(Ht,mt)' + chr(125)
                r_mt = 'set selectedToolIds(mt)' + chr(123) + 'c(Ht,mt),localStorage.setItem("selectedToolIds",JSON.stringify(mt))' + chr(125)
                if s_mt in c:
                    c = c.replace(s_mt, r_mt)
                    changed = True
                if 'c(Sr,[]),c(Ht,[]),c(hr,[])' in c:
                    c = c.replace('c(Sr,[]),c(Ht,[]),c(hr,[])', 'c(Sr,[]),c(Ht,' + get_tool_ids + '),c(hr,[])')
                    changed = True
                s_xo = 'Xo=async()=>' + chr(123) + 'c(Ht,[]),c(hr,[])'
                r_xo = 'Xo=async()=>' + chr(123) + 'c(Ht,' + get_tool_ids + '),c(hr,[])'
                if s_xo in c:
                    c = c.replace(s_xo, r_xo)
                    changed = True
                if changed:
                    with open(f, 'w', encoding='utf-8') as fp:
                        fp.write(c)
                    print(f"Successfully patched tool ON/OFF persistence in {os.path.basename(f)}")
        except Exception as e:
            print(f"Warning: Failed to patch tool persistence in entrypoint: {e}")
        PYEOF

        exec bash /app/backend/start.sh "$@"

  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: open-webui-loader-js
      labels:
        app.kubernetes.io/name: open-webui
        app.kubernetes.io/component: open-webui
    data:
      loader.js: |
        // Open WebUI ロケール & 地球儀アイコン (Web 検索) 自動初期化
        (function() {
          try {
            var defaultLocale = {{ open_webui_default_locale | default('ja-JP') | to_json }};
            var defaultSystemPrompt = {{ open_webui_default_system_prompt | default('') | to_json }};
            var currentLocale = localStorage.getItem('locale');
            // 未設定、または英語 (en-US, en, null, undefined) の場合はデフォルト日本語に同期
            if (!currentLocale || currentLocale === 'en-US' || currentLocale === 'en') {
              localStorage.setItem('locale', defaultLocale);
            }
            if (document.documentElement) {
              document.documentElement.setAttribute('lang', defaultLocale);
            }

            // ユーザー設定 (settings) の locale & webSearch & system 同期
            var rawSettings = localStorage.getItem('settings');
            var settings = rawSettings ? JSON.parse(rawSettings) : {};
            if (!settings.ui) settings.ui = {};
            var settingsUpdated = false;
            if (!settings.ui.locale || settings.ui.locale === 'en-US' || settings.ui.locale === 'en') {
              settings.ui.locale = defaultLocale;
              settingsUpdated = true;
            }
            if (settings.ui.webSearch !== 'always') {
              settings.ui.webSearch = 'always';
              settingsUpdated = true;
            }
            if (defaultSystemPrompt && (!settings.system || settings.system.trim() === '')) {
              settings.system = defaultSystemPrompt;
              settingsUpdated = true;
            }
            if (settingsUpdated) {
              localStorage.setItem('settings', JSON.stringify(settings));
            }
          } catch (e) {
            console.error('Failed to initialize in loader.js:', e);
          }
        })();


