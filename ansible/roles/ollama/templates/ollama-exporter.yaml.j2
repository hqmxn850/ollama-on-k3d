---
# ==============================================================================
# Ollama Prometheus Exporter Manifests
# ==============================================================================

# 1. ConfigMap (Ollama Prometheus Exporter Python スクリプト)
apiVersion: v1
kind: ConfigMap
metadata:
  name: ollama-exporter-script
  namespace: {{ ollama_namespace | default('ollama') }}
  labels:
    app.kubernetes.io/name: ollama-exporter
data:
  exporter.py: |
    import http.server
    import json
    import os
    import sys
    import time
    import urllib.request

    OLLAMA_HOST = os.environ.get("OLLAMA_HOST", "http://ollama:11434")
    EXPORTER_PORT = int(os.environ.get("EXPORTER_PORT", "9115"))

    def fetch_json(endpoint):
        url = f"{OLLAMA_HOST}{endpoint}"
        req = urllib.request.Request(url, headers={"User-Agent": "ollama-exporter"})
        with urllib.request.urlopen(req, timeout=5) as res:
            return json.loads(res.read().decode())

    def generate_metrics():
        lines = []
        lines.append("# HELP ollama_up Whether Ollama service is up (1) or down (0)")
        lines.append("# TYPE ollama_up gauge")

        start_time = time.time()
        try:
            ver_data = fetch_json("/api/version")
            duration = time.time() - start_time
            version = ver_data.get("version", "unknown")
            lines.append("ollama_up 1")
            lines.append('ollama_build_info{version="%s"} 1' % version)
            lines.append(f"ollama_scrape_duration_seconds {duration:.4f}")
        except Exception:
            lines.append("ollama_up 0")
            lines.append(f"ollama_scrape_duration_seconds {time.time() - start_time:.4f}")
            return "\n".join(lines) + "\n"

        # モデル一覧取得
        try:
            tags_data = fetch_json("/api/tags")
            models = tags_data.get("models", [])
            lines.append("# HELP ollama_models_total Total number of models stored in Ollama")
            lines.append("# TYPE ollama_models_total gauge")
            lines.append(f"ollama_models_total {len(models)}")

            lines.append("# HELP ollama_model_size_bytes Model disk size in bytes")
            lines.append("# TYPE ollama_model_size_bytes gauge")
            for m in models:
                name = m.get("name", "")
                size = m.get("size", 0)
                details = m.get("details", {})
                family = details.get("family", "")
                param_size = details.get("parameter_size", "")
                quant = details.get("quantization_level", "")
                lines.append('ollama_model_size_bytes{model="%s",family="%s",parameter_size="%s",quantization="%s"} %s' % (name, family, param_size, quant, size))
        except Exception as e:
            sys.stderr.write(f"[ollama-exporter] Error fetching /api/tags: {e}\n")
            lines.append("# HELP ollama_models_total Total number of models stored in Ollama")
            lines.append("# TYPE ollama_models_total gauge")
            lines.append("ollama_models_total 0")

        # ロード中モデル取得
        try:
            ps_data = fetch_json("/api/ps")
            running_models = ps_data.get("models", [])
            lines.append("# HELP ollama_loaded_models_total Total number of models currently loaded in memory/VRAM")
            lines.append("# TYPE ollama_loaded_models_total gauge")
            lines.append(f"ollama_loaded_models_total {len(running_models)}")

            lines.append("# HELP ollama_model_vram_bytes Model VRAM consumption in bytes")
            lines.append("# TYPE ollama_model_vram_bytes gauge")
            for rm in running_models:
                name = rm.get("name", "")
                vram = rm.get("size_vram", 0)
                lines.append('ollama_model_vram_bytes{model="%s"} %s' % (name, vram))
        except Exception as e:
            sys.stderr.write(f"[ollama-exporter] Error fetching /api/ps: {e}\n")
            lines.append("# HELP ollama_loaded_models_total Total number of models currently loaded in memory/VRAM")
            lines.append("# TYPE ollama_loaded_models_total gauge")
            lines.append("ollama_loaded_models_total 0")

        return "\n".join(lines) + "\n"

    class MetricsHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path in ("/metrics", "/metrics/"):
                content = generate_metrics().encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "text/plain; version=0.0.4; charset=utf-8")
                self.send_header("Content-Length", str(len(content)))
                self.end_headers()
                self.wfile.write(content)
            elif self.path in ("/", "/health", "/healthz"):
                self.send_response(200)
                self.send_header("Content-Type", "text/plain")
                self.end_headers()
                self.wfile.write(b"OK\n")
            else:
                self.send_response(404)
                self.end_headers()

        def log_message(self, format, *args):
            pass

    def run():
        server = http.server.ThreadingHTTPServer(("0.0.0.0", EXPORTER_PORT), MetricsHandler)
        print(f"Ollama Prometheus Exporter listening on port {EXPORTER_PORT}...")
        server.serve_forever()

    if __name__ == "__main__":
        run()

---
# 2. Deployment (Ollama Exporter)
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ollama-exporter
  namespace: {{ ollama_namespace | default('ollama') }}
  labels:
    app.kubernetes.io/name: ollama-exporter
    app.kubernetes.io/instance: ollama-exporter
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: ollama-exporter
      app.kubernetes.io/instance: ollama-exporter
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ollama-exporter
        app.kubernetes.io/instance: ollama-exporter
    spec:
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      containers:
        - name: exporter
          image: {{ oga_image | default('docker.io/library/python:3.12-slim') | quote }}
          imagePullPolicy: IfNotPresent
          command: ["python3", "/app/exporter.py"]
          ports:
            - name: metrics
              containerPort: {{ ollama_exporter_port | default(9115) }}
              protocol: TCP
          env:
            - name: OLLAMA_HOST
              value: "http://ollama:{{ ollama_port | default(11434) }}"
            - name: EXPORTER_PORT
              value: "{{ ollama_exporter_port | default(9115) }}"
          resources:
            requests:
              cpu: "50m"
              memory: "64Mi"
            limits:
              cpu: "200m"
              memory: "128Mi"
          volumeMounts:
            - name: script-volume
              mountPath: /app
          readinessProbe:
            httpGet:
              path: /health
              port: {{ ollama_exporter_port | default(9115) }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: {{ ollama_exporter_port | default(9115) }}
            initialDelaySeconds: 10
            periodSeconds: 15
      volumes:
        - name: script-volume
          configMap:
            name: ollama-exporter-script
            defaultMode: 0755

---
# 3. Service (Ollama Exporter)
apiVersion: v1
kind: Service
metadata:
  name: ollama-exporter
  namespace: {{ ollama_namespace | default('ollama') }}
  labels:
    app.kubernetes.io/name: ollama-exporter
    app.kubernetes.io/instance: ollama-exporter
spec:
  type: ClusterIP
  ports:
    - name: metrics
      port: {{ ollama_exporter_port | default(9115) }}
      targetPort: {{ ollama_exporter_port | default(9115) }}
      protocol: TCP
  selector:
    app.kubernetes.io/name: ollama-exporter
    app.kubernetes.io/instance: ollama-exporter
