---
# ==========================================================
# Application Plane Protection NetworkPolicy: Ollama (ollama)
# ==========================================================
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: ollama-app-protection
  namespace: {{ ollama_namespace | default('ollama') }}
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
  ingress:
    # 1. 同一名前空間内の通信
    - from:
        - podSelector: {}

    # 2. Traefik Ingress (kube-system) からの Ollama API アクセス
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ kube_system_namespace | default('kube-system') }}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: traefik
      ports:
        - protocol: TCP
          port: {{ ollama_port | default(11434) }}

    # 3. クラスタ内部クライアントからの API アクセス許可
    - ports:
        - protocol: TCP
          port: {{ ollama_port | default(11434) }}

    # 4. Prometheus 監視基盤からのメトリクススクレイプ許可
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ monitoring_namespace | default('cattle-monitoring-system') }}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: prometheus
      ports:
        - protocol: TCP
          port: {{ ollama_exporter_port | default(9115) }}
    - ports:
        - protocol: TCP
          port: {{ ollama_exporter_port | default(9115) }}

  egress:
    # 1. DNS 名前解決 (CoreDNS)
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ kube_system_namespace | default('kube-system') }}
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - protocol: UDP
          port: 53
        - protocol: TCP
          port: 53

    # 2. 同一名前空間内の通信
    - to:
        - podSelector: {}

    # 3. 外部モデルダウンロード・HTTPS 通信 (ollama.com / HuggingFace 等)
    - to:
        - ipBlock:
            cidr: 0.0.0.0/0
            except:
              - {{ podman_network_cidr | default('10.89.0.0/24') }}
      ports:
        - protocol: TCP
          port: {{ http_port | default(80) }}
        - protocol: TCP
          port: {{ https_port | default(443) }}
