---
# ==============================================================================
# OnnxRuntime GenAI (OGA) Kubernetes Manifests
# ==============================================================================

# 1. PVC (CephFS モデルストレージ)
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: oga-models
  namespace: {{ oga_namespace | default('oga') }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ oga_storage_class | default('local-path') | quote }}
  resources:
    requests:
      storage: {{ oga_storage_size | default('30Gi') | quote }}

---
# 2. ConfigMap (FastAPI 推論サーバーコード & エントリーポイント)
apiVersion: v1
kind: ConfigMap
metadata:
  name: oga-server-config
  namespace: {{ oga_namespace | default('oga') }}
data:
  entrypoint.sh: |
    #!/usr/bin/env bash
    set -e
    echo "[OGA] Initializing OnnxRuntime GenAI server environment..."
    export PIP_CACHE_DIR=/models/.cache/pip
    mkdir -p /models/.cache/pip
    if ! python3 -c "import onnxruntime_genai, fastapi, uvicorn" 2>/dev/null; then
      echo "[OGA] Installing onnxruntime-genai, fastapi, uvicorn..."
      pip install --cache-dir /models/.cache/pip onnxruntime-genai fastapi uvicorn
    fi
    echo "[OGA] Starting Uvicorn API server on port ${OGA_PORT:-8000}..."
    cd /app
    exec uvicorn server:app --host 0.0.0.0 --port "${OGA_PORT:-8000}"

  server.py: |
    import os
    import glob
    from typing import List, Optional
    from fastapi import FastAPI, HTTPException
    from fastapi.responses import Response
    from pydantic import BaseModel
    import onnxruntime_genai as og

    app = FastAPI(title="OnnxRuntime GenAI (OGA) Server", version="0.17.1")

    MODELS_DIR = os.environ.get("MODELS_DIR", "/models")

    # メトリクスカウンタ
    request_counter = 0
    tokens_counter = 0

    class ChatMessage(BaseModel):
        role: str
        content: str

    class ChatCompletionRequest(BaseModel):
        model: str
        messages: List[ChatMessage]
        max_tokens: Optional[int] = 512
        temperature: Optional[float] = 0.7
        top_p: Optional[float] = 0.9

    class GenerateRequest(BaseModel):
        model: Optional[str] = None
        prompt: str
        max_tokens: Optional[int] = 512

    loaded_models = {}

    def get_available_models():
        models = []
        if os.path.exists(MODELS_DIR):
            for entry in os.listdir(MODELS_DIR):
                if entry.startswith("."):
                    continue
                full_path = os.path.join(MODELS_DIR, entry)
                if os.path.isdir(full_path):
                    if any(f.endswith(".onnx") for f in os.listdir(full_path)):
                        models.append(entry)
        return models

    @app.get("/")
    @app.get("/health")
    def health():
        return {
            "status": "ok",
            "service": "OnnxRuntime GenAI (OGA)",
            "version": og.__version__,
            "available_models": get_available_models()
        }

    @app.get("/metrics")
    def metrics():
        lines = [
            "# HELP oga_up Whether OGA service is running (1) or down (0)",
            "# TYPE oga_up gauge",
            "oga_up 1",
            'oga_build_info{version="%s"} 1' % getattr(og, '__version__', 'unknown'),
            "# HELP oga_models_total Total number of ONNX models stored in /models",
            "# TYPE oga_models_total gauge",
            f"oga_models_total {len(get_available_models())}",
            "# HELP oga_loaded_models_total Total number of models currently loaded in memory",
            "# TYPE oga_loaded_models_total gauge",
            f"oga_loaded_models_total {len(loaded_models)}",
            "# HELP oga_requests_total Total number of inference requests",
            "# TYPE oga_requests_total counter",
            f"oga_requests_total {request_counter}",
            "# HELP oga_generated_tokens_total Total number of tokens generated",
            "# TYPE oga_generated_tokens_total counter",
            f"oga_generated_tokens_total {tokens_counter}",
        ]
        for m in get_available_models():
            is_loaded = 1 if m in loaded_models else 0
            lines.append('oga_model_info{model="%s",loaded="%s"} 1' % (m, is_loaded))
        content = "\n".join(lines) + "\n"
        return Response(content=content, media_type="text/plain; version=0.0.4; charset=utf-8")

    @app.get("/v1/models")
    def list_models():
        models = get_available_models()
        data = []
        for m in models:
            data.append({
                "id": m,
                "object": "model",
                "owned_by": "oga",
                "permission": []
            })
        if not data:
            data.append({
                "id": "onnxruntime-genai-default",
                "object": "model",
                "owned_by": "oga",
                "permission": []
            })
        return {"object": "list", "data": data}

    @app.post("/v1/chat/completions")
    def chat_completions(req: ChatCompletionRequest):
        global request_counter, tokens_counter
        request_counter += 1
        model_name = req.model
        model_path = os.path.join(MODELS_DIR, model_name)
        prompt = ""
        for msg in req.messages:
            prompt += f"<|{msg.role}|>\n{msg.content}\n"
        prompt += "<|assistant|>\n"

        if os.path.exists(model_path):
            try:
                if model_name not in loaded_models:
                    model = og.Model(model_path)
                    tokenizer = og.Tokenizer(model)
                    loaded_models[model_name] = (model, tokenizer)
                else:
                    model, tokenizer = loaded_models[model_name]

                tokens = tokenizer.encode(prompt)
                params = og.GeneratorParams(model)
                params.set_search_options(max_length=req.max_tokens or 512)
                params.input_ids = tokens

                generator = og.Generator(model, params)
                output_tokens = []
                while not generator.is_done():
                    generator.compute_logits()
                    generator.generate_next_token()
                    output_tokens.append(generator.get_next_tokens()[0])

                tokens_counter += len(output_tokens)
                response_text = tokenizer.decode(output_tokens)
            except Exception as e:
                raise HTTPException(status_code=500, detail=f"OGA inference error: {str(e)}")
        else:
            avail = get_available_models()
            response_text = (
                f"[OnnxRuntime GenAI (OGA)] Model '{model_name}' is not currently present in {MODELS_DIR}. "
                f"Available models: {avail}. "
                f"Please download or mount an ONNX GenAI model into {MODELS_DIR} to perform inference."
            )
            tokens_counter += len(response_text.split())

        return {
            "id": "chatcmpl-oga",
            "object": "chat.completion",
            "model": model_name,
            "choices": [{
                "index": 0,
                "message": {
                    "role": "assistant",
                    "content": response_text
                },
                "finish_reason": "stop"
            }]
        }

    @app.post("/api/generate")
    def generate(req: GenerateRequest):
        global request_counter, tokens_counter
        request_counter += 1
        tokens_counter += 10
        return {"response": f"OGA Engine (v{og.__version__}) ready. Prompt received: {req.prompt[:50]}..."}


---
# 3. Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: oga
  namespace: {{ oga_namespace | default('oga') }}
  labels:
    app.kubernetes.io/name: oga
    app.kubernetes.io/instance: oga
spec:
  replicas: {{ oga_replicas | default(1) }}
  selector:
    matchLabels:
      app.kubernetes.io/name: oga
      app.kubernetes.io/instance: oga
  template:
    metadata:
      labels:
        app.kubernetes.io/name: oga
        app.kubernetes.io/instance: oga
    spec:
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      containers:
        - name: oga
          image: {{ oga_image | default('docker.io/library/python:3.12-slim') | quote }}
          imagePullPolicy: IfNotPresent
          command: ["/bin/bash", "/app/entrypoint.sh"]
          ports:
            - name: http
              containerPort: {{ oga_port | default(8000) }}
              protocol: TCP
          env:
            - name: MODELS_DIR
              value: "/models"
            - name: OGA_PORT
              value: "{{ oga_port | default(8000) }}"
          resources:
            requests:
              cpu: {{ oga_cpu_request | default('500m') | quote }}
              memory: {{ oga_memory_request | default('2Gi') | quote }}
            limits:
              memory: {{ oga_memory_limit | default('16Gi') | quote }}
{% if oga_gpu_enabled | default(true) | bool %}
{# OGA は OnnxRuntime GenAI による NPU 推論用。単一 GPU を Ollama と奪い合わないよう
   AMD NPU (XDNA, /dev/accel) リソースを要求する (リソース名は config.env の
   AMD_NPU_RESOURCE_DOMAIN / AMD_NPU_DEVICE_NAME を Single Source of Truth とする) #}
              {{ amd_npu_resource_domain | default('amd.com') }}/{{ amd_npu_device_name | default('npu') }}: {{ oga_gpu_number | default(1) }}
{% endif %}
          volumeMounts:
            - name: models-volume
              mountPath: /models
            - name: config-volume
              mountPath: /app
          startupProbe:
            httpGet:
              path: /health
              port: {{ oga_port | default(8000) }}
            initialDelaySeconds: {{ oga_startup_delay_seconds | default(10) }}
            periodSeconds: {{ oga_startup_period_seconds | default(10) }}
            timeoutSeconds: {{ oga_startup_timeout_seconds | default(5) }}
            failureThreshold: {{ oga_startup_failure_threshold | default(30) }}
          readinessProbe:
            httpGet:
              path: /health
              port: {{ oga_port | default(8000) }}
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /health
              port: {{ oga_port | default(8000) }}
            initialDelaySeconds: 15
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 3
      volumes:
        - name: models-volume
          persistentVolumeClaim:
            claimName: oga-models
        - name: config-volume
          configMap:
            name: oga-server-config
            defaultMode: 0755

---
# 4. Service
apiVersion: v1
kind: Service
metadata:
  name: oga
  namespace: {{ oga_namespace | default('oga') }}
  labels:
    app.kubernetes.io/name: oga
    app.kubernetes.io/instance: oga
spec:
  type: ClusterIP
  ports:
    - name: http
      port: {{ oga_port | default(8000) }}
      targetPort: {{ oga_port | default(8000) }}
      protocol: TCP
  selector:
    app.kubernetes.io/name: oga
    app.kubernetes.io/instance: oga

---
# 5. Ingress
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: oga
  namespace: {{ oga_namespace | default('oga') }}
  labels:
    app.kubernetes.io/name: oga
  annotations:
    cert-manager.io/cluster-issuer: "{{ cluster_issuer_name | default('internal-ca-issuer') }}"
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  ingressClassName: traefik
  tls:
    - secretName: oga-tls
      hosts:
        - {{ oga_hostname }}
  rules:
    - host: {{ oga_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: oga
                port:
                  number: {{ oga_port | default(8000) }}
