---
# ==============================================================================
# OnnxRuntime GenAI (OGA) Kubernetes Manifests
# ==============================================================================

# 1. PVC (モデルストレージ / storageClassName: {{ oga_storage_class | default('local-path') }})
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: oga-models
  namespace: {{ oga_namespace | default('oga') }}
spec:
  accessModes:
    - ReadWriteOnce
  storageClassName: {{ oga_storage_class | default('local-path') | quote }}
  resources:
    requests:
      storage: {{ oga_storage_size | default('30Gi') | quote }}

---
# 2. ConfigMap (FastAPI 推論サーバーコード & エントリーポイント)
apiVersion: v1
kind: ConfigMap
metadata:
  name: oga-server-config
  namespace: {{ oga_namespace | default('oga') }}
data:
  entrypoint.sh: |
    #!/usr/bin/env bash
    set -e
    echo "[OGA] Initializing OnnxRuntime GenAI & NPU Gateway environment..."
    export PIP_CACHE_DIR=/models/.cache/pip
    mkdir -p /models/.cache/pip
    if ! python3 -c "import httpx, fastapi, uvicorn" 2>/dev/null; then
      echo "[OGA] Installing httpx, fastapi, uvicorn..."
      pip install --cache-dir /models/.cache/pip httpx fastapi uvicorn
    fi
    echo "[OGA] Starting Uvicorn API server on port ${OGA_PORT:-8000}..."
    cd /app
    exec uvicorn server:app --host 0.0.0.0 --port "${OGA_PORT:-8000}"

  server.py: |
{% raw %}
    import os
    import json
    import logging
    import asyncio
    from typing import List, Optional, Any
    from fastapi import FastAPI, HTTPException, Request
    from fastapi.responses import Response, StreamingResponse
    import httpx

    app = FastAPI(title="OGA & FastFlowLM NPU Gateway", version="1.0.0")

    NPU_FLM_URL = os.environ.get("NPU_FLM_URL", "").rstrip("/")
    NPU_DEFAULT_MODEL = os.environ.get("NPU_DEFAULT_MODEL", "qwen3:0.6b")
    MODELS_DIR = os.environ.get("MODELS_DIR", "/models")
    NPU_FLM_CLIENT_TIMEOUT = float(os.environ.get("NPU_FLM_CLIENT_TIMEOUT", "300.0"))
    NPU_FLM_HEALTH_TIMEOUT = float(os.environ.get("NPU_FLM_HEALTH_TIMEOUT", "3.0"))
    NPU_FLM_PROBE_PATH = os.environ.get("NPU_FLM_PROBE_PATH", "/v1/models")

    request_counter = 0
    tokens_counter = 0
    npu_lock = asyncio.Lock()
    http_client = httpx.AsyncClient(timeout=NPU_FLM_CLIENT_TIMEOUT)

    def get_local_onnx_models():
        models = []
        if os.path.exists(MODELS_DIR):
            for entry in os.listdir(MODELS_DIR):
                if entry.startswith("."):
                    continue
                full_path = os.path.join(MODELS_DIR, entry)
                if os.path.isdir(full_path):
                    if any(f.endswith(".onnx") for f in os.listdir(full_path)):
                        models.append(entry)
        return models

    @app.get("/")
    @app.get("/health")
    async def health():
        flm_status = "disabled"
        if NPU_FLM_URL:
            try:
                r = await http_client.get(f"{NPU_FLM_URL}{NPU_FLM_PROBE_PATH}", timeout=NPU_FLM_HEALTH_TIMEOUT)
                flm_status = "healthy" if r.status_code == 200 else f"unhealthy ({r.status_code})"
            except Exception as e:
                flm_status = f"unreachable: {str(e)}"
        return {
            "status": "ok",
            "service": "OnnxRuntime GenAI (OGA) & NPU Gateway",
            "npu_backend": flm_status,
            "default_npu_model": NPU_DEFAULT_MODEL,
            "local_onnx_models": get_local_onnx_models()
        }

    @app.get("/metrics")
    async def metrics():
        lines = [
            "# HELP oga_up Whether OGA service is running (1) or down (0)",
            "# TYPE oga_up gauge",
            "oga_up 1",
            f'oga_backend_info{{type="fastflowlm",url="{NPU_FLM_URL}",model="{NPU_DEFAULT_MODEL}"}} 1',
            "# HELP oga_requests_total Total number of inference requests",
            "# TYPE oga_requests_total counter",
            f"oga_requests_total {request_counter}",
            "# HELP oga_generated_tokens_total Total number of tokens generated",
            "# TYPE oga_generated_tokens_total counter",
            f"oga_generated_tokens_total {tokens_counter}",
        ]
        content = "\n".join(lines) + "\n"
        return Response(content=content, media_type="text/plain; version=0.0.4; charset=utf-8")

    @app.get("/v1/models")
    async def list_models():
        models_data = []
        if NPU_FLM_URL:
            models_data.append({
                "id": NPU_DEFAULT_MODEL,
                "object": "model",
                "owned_by": "FastFlowLM-NPU",
                "permission": []
            })
        for m in get_local_onnx_models():
            if m != NPU_DEFAULT_MODEL:
                models_data.append({
                    "id": m,
                    "object": "model",
                    "owned_by": "oga-local",
                    "permission": []
                })
        if not models_data:
            models_data.append({
                "id": NPU_DEFAULT_MODEL,
                "object": "model",
                "owned_by": "npu",
                "permission": []
            })
        return {"object": "list", "data": models_data}

    @app.post("/v1/chat/completions")
    async def chat_completions(request: Request):
        global request_counter, tokens_counter
        request_counter += 1
        body = await request.json()

        if not body.get("model") or body.get("model") in ["default", "oga", "npu"]:
            body["model"] = NPU_DEFAULT_MODEL

        is_stream = body.get("stream", False)

        if NPU_FLM_URL:
            target_url = f"{NPU_FLM_URL}/v1/chat/completions"
            if is_stream:
                async def event_generator():
                    global tokens_counter
                    try:
                        async with npu_lock:
                            req = http_client.build_request("POST", target_url, json=body, timeout=NPU_FLM_CLIENT_TIMEOUT)
                            r = await http_client.send(req, stream=True)
                            async for chunk in r.aiter_bytes():
                                tokens_counter += 1
                                yield chunk
                    except httpx.TimeoutException:
                        yield f"data: {{\"error\": \"NPU request timed out after {NPU_FLM_CLIENT_TIMEOUT}s\"}}\n\n".encode()
                    except Exception as e:
                        err_msg = str(e) or e.__class__.__name__
                        yield f"data: {{\"error\": \"NPU proxy error: {err_msg}\"}}\n\n".encode()
                return StreamingResponse(event_generator(), media_type="text/event-stream")
            else:
                try:
                    async with npu_lock:
                        r = await http_client.post(target_url, json=body, timeout=NPU_FLM_CLIENT_TIMEOUT)
                        data = r.json()
                        if "usage" in data and "completion_tokens" in data["usage"]:
                            tokens_counter += data["usage"]["completion_tokens"]
                        return data
                except httpx.TimeoutException:
                    raise HTTPException(status_code=504, detail=f"NPU request timed out after {NPU_FLM_CLIENT_TIMEOUT}s")
                except Exception as e:
                    err_msg = str(e) or e.__class__.__name__
                    raise HTTPException(status_code=502, detail=f"Failed to communicate with NPU backend: {err_msg}")

        raise HTTPException(status_code=503, detail="No NPU backend configured and local ONNX model not found")

    @app.post("/api/generate")
    async def generate(request: Request):
        global request_counter, tokens_counter
        request_counter += 1
        body = await request.json()
        prompt = body.get("prompt", "")
        model = body.get("model", NPU_DEFAULT_MODEL)

        chat_payload = {
            "model": model,
            "messages": [{"role": "user", "content": prompt}],
            "stream": False
        }
        if NPU_FLM_URL:
            try:
                async with npu_lock:
                    r = await http_client.post(f"{NPU_FLM_URL}/v1/chat/completions", json=chat_payload, timeout=NPU_FLM_CLIENT_TIMEOUT)
                    data = r.json()
                    resp_text = data.get("choices", [{}])[0].get("message", {}).get("content", "")
                    tokens_counter += data.get("usage", {}).get("completion_tokens", 10)
                    return {"response": resp_text, "model": model, "done": True}
            except httpx.TimeoutException:
                return {"response": f"NPU error: Request timed out after {NPU_FLM_CLIENT_TIMEOUT}s", "done": True}
            except Exception as e:
                err_msg = str(e) or e.__class__.__name__
                return {"response": f"NPU error: {err_msg}", "done": True}

        return {"response": f"OGA Gateway ready. Prompt: {prompt[:50]}...", "done": True}
{% endraw %}

---
# 3. Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: oga
  namespace: {{ oga_namespace | default('oga') }}
  labels:
    app.kubernetes.io/name: oga
    app.kubernetes.io/instance: oga
spec:
  replicas: {{ oga_replicas | default(1) }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: oga
      app.kubernetes.io/instance: oga
  template:
    metadata:
      labels:
        app.kubernetes.io/name: oga
        app.kubernetes.io/instance: oga
    spec:
      nodeSelector:
        node-role.kubernetes.io/worker: "true"
      containers:
        - name: oga
          image: {{ oga_image | default('docker.io/library/python:3.12-slim') | quote }}
          imagePullPolicy: IfNotPresent
          command: ["/bin/bash", "/app/entrypoint.sh"]
          ports:
            - name: http
              containerPort: {{ oga_port | default(8000) }}
              protocol: TCP
          env:
            - name: MODELS_DIR
              value: "/models"
            - name: OGA_PORT
              value: "{{ oga_port | default(8000) }}"
            - name: NPU_FLM_URL
              value: "{{ 'http://' ~ npu_flm_host_ip ~ ':' ~ npu_flm_port if (npu_flm_enabled | default(true) | bool) else '' }}"
            - name: NPU_DEFAULT_MODEL
              value: "{{ npu_flm_default_model | default('qwen3:0.6b') }}"
            - name: NPU_FLM_CLIENT_TIMEOUT
              value: "{{ npu_flm_client_timeout | default(300.0) | string }}"
            - name: NPU_FLM_HEALTH_TIMEOUT
              value: "{{ npu_flm_health_timeout | default(3.0) | string }}"
            - name: NPU_FLM_PROBE_PATH
              value: "{{ npu_flm_probe_path | default('/v1/models') | quote }}"
          resources:
            requests:
              cpu: {{ oga_cpu_request | default('500m') | quote }}
              memory: {{ oga_memory_request | default('2Gi') | quote }}
            limits:
              memory: {{ oga_memory_limit | default('16Gi') | quote }}
{% if oga_gpu_enabled | default(true) | bool %}
{# OGA は OnnxRuntime GenAI による NPU 推論用。単一 GPU を Ollama と奪い合わないよう
   AMD NPU (XDNA, /dev/accel) リソースを要求する (リソース名は config.env の
   AMD_NPU_RESOURCE_DOMAIN / AMD_NPU_DEVICE_NAME を Single Source of Truth とする) #}
              {{ amd_npu_resource_domain | default('amd.com') }}/{{ amd_npu_device_name | default('npu') }}: {{ oga_gpu_number | default(1) }}
{% endif %}
          volumeMounts:
            - name: models-volume
              mountPath: /models
            - name: config-volume
              mountPath: /app
          startupProbe:
            httpGet:
              path: /health
              port: {{ oga_port | default(8000) }}
            initialDelaySeconds: {{ oga_startup_delay_seconds | default(10) }}
            periodSeconds: {{ oga_startup_period_seconds | default(10) }}
            timeoutSeconds: {{ oga_startup_timeout_seconds | default(5) }}
            failureThreshold: {{ oga_startup_failure_threshold | default(30) }}
          readinessProbe:
            httpGet:
              path: /health
              port: {{ oga_port | default(8000) }}
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /health
              port: {{ oga_port | default(8000) }}
            initialDelaySeconds: 15
            periodSeconds: 15
            timeoutSeconds: 5
            failureThreshold: 3
      volumes:
        - name: models-volume
          persistentVolumeClaim:
            claimName: oga-models
        - name: config-volume
          configMap:
            name: oga-server-config
            defaultMode: 0755

---
# 4. Service
apiVersion: v1
kind: Service
metadata:
  name: oga
  namespace: {{ oga_namespace | default('oga') }}
  labels:
    app.kubernetes.io/name: oga
    app.kubernetes.io/instance: oga
spec:
  type: ClusterIP
  ports:
    - name: http
      port: {{ oga_port | default(8000) }}
      targetPort: {{ oga_port | default(8000) }}
      protocol: TCP
  selector:
    app.kubernetes.io/name: oga
    app.kubernetes.io/instance: oga

---
# 5. Ingress
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: oga
  namespace: {{ oga_namespace | default('oga') }}
  labels:
    app.kubernetes.io/name: oga
  annotations:
    cert-manager.io/cluster-issuer: "{{ cluster_issuer_name | default('internal-ca-issuer') }}"
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  ingressClassName: traefik
  tls:
    - secretName: oga-tls
      hosts:
        - {{ oga_hostname }}
  rules:
    - host: {{ oga_hostname }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: oga
                port:
                  number: {{ oga_port | default(8000) }}
