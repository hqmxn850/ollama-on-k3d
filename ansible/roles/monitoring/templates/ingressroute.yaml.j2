apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: redirect-https
  namespace: {{ kube_system_namespace | default('kube-system') }}
spec:
  redirectScheme:
    scheme: https
    permanent: true
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: grafana
  namespace: {{ monitoring_namespace | default('cattle-monitoring-system') }}
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`{{ grafana_hostname }}`)
      kind: Rule
      services:
        - name: kube-prometheus-stack-grafana
          port: {{ http_port | default(80) }}
  tls:
    domains:
      - main: {{ grafana_hostname }}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: grafana-http
  namespace: {{ monitoring_namespace | default('cattle-monitoring-system') }}
spec:
  entryPoints:
    - web
  routes:
    - match: Host(`{{ grafana_hostname }}`)
      kind: Rule
      middlewares:
        - name: redirect-https
          namespace: {{ kube_system_namespace | default('kube-system') }}
      services:
        - name: kube-prometheus-stack-grafana
          port: {{ http_port | default(80) }}
