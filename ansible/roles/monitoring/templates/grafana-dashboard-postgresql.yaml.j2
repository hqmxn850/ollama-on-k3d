                "last"
              ],
              "displayMode": "table",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "pluginVersion": "10.0.0",
          "targets": [
            {
              "editorMode": "code",
              "expr": "pg_stat_database_numbackends{datname=~\"keycloak|postgres\"}",
              "legendFormat": "{{datname}} ({{instance}})",
              "range": true,
