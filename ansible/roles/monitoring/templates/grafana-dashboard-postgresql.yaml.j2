            "orientation": "auto",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "auto"
          },
          "pluginVersion": "10.0.0",
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum(pg_database_size_bytes{datname=~\"keycloak|grafana|harbor|postgres\"})",
              "instant": true,
              "legendFormat": "Total DB Size",
              "range": false,
              "refId": "A"
            }
          ],
          "title": "Total Database Size",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "mappings": [],
              "max": 100,
              "min": 0,
              "thresholds": {
                "mode": "absolute",
