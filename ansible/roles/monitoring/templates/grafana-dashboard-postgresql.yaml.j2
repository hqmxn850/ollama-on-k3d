                  {
                    "color": "yellow",
                    "value": 90
                  },
                  {
                    "color": "green",
                    "value": 98
                  }
                ]
              },
              "unit": "percent"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 16,
            "y": 1
          },
          "id": 5,
          "options": {
            "colorMode": "value",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "auto"
          },
          "pluginVersion": "10.0.0",
          "targets": [
            {
              "editorMode": "code",
              "expr": "(sum(rate(pg_stat_database_blks_hit{datname=\"keycloak\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"keycloak\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"keycloak\"}[5m])) > 0 or 1)) * 100",
              "instant": true,
              "legendFormat": "Hit Ratio",
              "range": false,
              "refId": "A"
            }
          ],
          "title": "Buffer Cache Hit Ratio",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "color": {
                "mode": "thresholds"
              },
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "red",
                    "value": 1
                  }
                ]
              },
              "unit": "short"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 20,
            "y": 1
          },
          "id": 6,
          "options": {
            "colorMode": "value",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "textMode": "auto"
          },
          "pluginVersion": "10.0.0",
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum(pg_stat_database_deadlocks{datname=\"keycloak\"})",
              "instant": true,
              "legendFormat": "Deadlocks",
              "range": false,
              "refId": "A"
            }
          ],
          "title": "Total Deadlocks",
          "type": "stat"
        },
        {
          "collapsed": false,
          "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 5
          },
          "id": 101,
          "title": "Transactions & Throughput",
          "type": "row"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 15
              },
              "unit": "ops"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 6
          },
          "id": 7,
          "options": {
            "legend": {
              "calcs": [
                "mean",
                "max",
                "last"
              ],
              "displayMode": "table",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "pluginVersion": "10.0.0",
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"keycloak\"}[1m])) by (instance)",
              "legendFormat": "Commit ({{instance}})",
              "range": true,
              "refId": "A"
            },
            {
              "editorMode": "code",
              "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"keycloak\"}[1m])) by (instance)",
              "legendFormat": "Rollback ({{instance}})",
              "range": true,
              "refId": "B"
            }
          ],
          "title": "Transactions Rate (TPS)",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 15
              },
              "unit": "ops"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 6
          },
          "id": 8,
          "options": {
            "legend": {
              "calcs": [
                "mean",
                "max",
                "last"
              ],
              "displayMode": "table",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "pluginVersion": "10.0.0",
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum(rate(pg_stat_database_tup_fetched{datname=\"keycloak\"}[1m]))",
              "legendFormat": "Fetched",
              "range": true,
              "refId": "A"
            },
            {
              "editorMode": "code",
              "expr": "sum(rate(pg_stat_database_tup_inserted{datname=\"keycloak\"}[1m]))",
              "legendFormat": "Inserted",
              "range": true,
              "refId": "B"
            },
            {
              "editorMode": "code",
              "expr": "sum(rate(pg_stat_database_tup_updated{datname=\"keycloak\"}[1m]))",
              "legendFormat": "Updated",
              "range": true,
              "refId": "C"
            },
            {
              "editorMode": "code",
              "expr": "sum(rate(pg_stat_database_tup_deleted{datname=\"keycloak\"}[1m]))",
              "legendFormat": "Deleted",
              "range": true,
              "refId": "D"
            }
          ],
          "title": "Rows Operations Rate",
          "type": "timeseries"
        },
        {
          "collapsed": false,
          "gridPos": {
            "h": 1,
            "w": 24,
            "x": 0,
            "y": 14
