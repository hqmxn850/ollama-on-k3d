              "range": true,
              "refId": "A"
            }
          ],
          "title": "Locks by Mode",
          "type": "timeseries"
        }
      ],
      "refresh": "10s",
      "schemaVersion": 38,
      "style": "dark",
      "tags": [
        "postgresql",
        "database",
        "keycloak"
      ],
      "time": {
        "from": "now-1h",
