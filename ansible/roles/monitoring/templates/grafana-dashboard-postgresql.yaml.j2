              "legendFormat": "Blocks Hit",
              "range": true,
              "refId": "A"
            },
            {
              "editorMode": "code",
              "expr": "sum(rate(pg_stat_database_blks_read{datname=\"keycloak\"}[1m])) * 8192",
              "legendFormat": "Blocks Read (Disk)",
              "range": true,
              "refId": "B"
            }
          ],
          "title": "Buffer I/O Throughput",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "fieldConfig": {
            "defaults": {
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
