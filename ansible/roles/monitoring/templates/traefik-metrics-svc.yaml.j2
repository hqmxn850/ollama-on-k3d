apiVersion: v1
kind: Service
metadata:
  name: traefik-metrics
  namespace: {{ kube_system_namespace | default('kube-system') }}
  labels:
    app.kubernetes.io/name: traefik
    app.kubernetes.io/instance: traefik-kube-system
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: traefik
    app.kubernetes.io/instance: traefik-kube-system
  ports:
  - name: metrics
    port: {{ traefik_metrics_port | default(9100) }}
    targetPort: {{ traefik_metrics_port | default(9100) }}
    protocol: TCP
