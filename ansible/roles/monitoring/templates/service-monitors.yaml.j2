apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: keycloak
  namespace: {{ keycloak_namespace | default('keycloak') }}
  labels:
    release: kube-prometheus-stack
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: keycloak
  namespaceSelector:
    matchNames:
    - {{ keycloak_namespace | default('keycloak') }}
  endpoints:
  - port: management
    path: /metrics
    interval: 30s
{% if keycloak_pg_metrics_enabled | default(true) | bool %}
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: keycloak-pg-postgresql
  namespace: {{ keycloak_namespace | default('keycloak') }}
  labels:
    release: kube-prometheus-stack
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: postgresql
      app.kubernetes.io/component: metrics
  namespaceSelector:
    matchNames:
    - {{ keycloak_namespace | default('keycloak') }}
  endpoints:
  - port: http-metrics
    path: /metrics
    interval: 30s
{% endif %}
