apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: rancher
  namespace: {{ rancher_namespace | default('cattle-system') }}
  labels:
    release: kube-prometheus-stack
spec:
  selector:
    matchLabels:
      app: rancher
  namespaceSelector:
    matchNames:
    - {{ rancher_namespace | default('cattle-system') }}
  endpoints:
  - port: https
    path: /metrics
    interval: 30s
    scheme: https
    tlsConfig:
      insecureSkipVerify: true
    bearerTokenSecret:
      name: rancher-monitoring-token
      key: token

