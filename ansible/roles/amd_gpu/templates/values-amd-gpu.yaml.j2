# ==============================================================================
# AMD GPU Device Plugin (ROCm k8s-device-plugin) Helm values
# リテラルは ansible/group_vars/all.yml (Single Source of Truth) を参照
# ==============================================================================

# Node Feature Discovery 連携 (本クラスタでは NFD 未導入のため無効)
nfd:
  enabled: {{ amd_gpu_nfd_enabled | default(false) | bool | lower }}

# GPU ノードラベル付与 (NFD ラベル前提のため無効)
labeller:
  enabled: {{ amd_gpu_labeller_enabled | default(false) | bool | lower }}

dp:
  image:
    repository: {{ amd_gpu_device_plugin_repository | default('docker.io/rocm/k8s-device-plugin', true) }}
    tag: {{ amd_gpu_device_plugin_tag | default('1.31.0.9', true) | quote }}

# Worker ノード限定配置 (AGENTS.md の配置ルール / node-role.kubernetes.io/worker)
# chart 既定の PCI ラベルは NFD 未導入のため使えないため null で除去する
node_selector_enabled: {{ amd_gpu_node_selector_enabled | default(true) | bool | lower }}
node_selector:
  feature.node.kubernetes.io/pci-0300_1002.present: null
  kubernetes.io/arch: amd64
  node-role.kubernetes.io/worker: "true"
