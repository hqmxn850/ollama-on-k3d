# TCP/IP チューニング設定 (Ansible で自動生成・管理)
# config.env の SYSCTL_* 変数から反映される

# 接続待ちキュー
net.core.somaxconn = {{ sysctl_somaxconn | default(65535) }}
net.ipv4.tcp_max_syn_backlog = {{ sysctl_tcp_max_syn_backlog | default(65535) }}
net.core.netdev_max_backlog = {{ sysctl_netdev_max_backlog | default(65535) }}
net.core.netdev_budget = {{ sysctl_netdev_budget | default(600) }}

# TCP 輻輳制御 & キューイング規則 (BBR + FQ: 高スループット・低遅延)
net.core.default_qdisc = {{ sysctl_default_qdisc | default('fq') }}
net.ipv4.tcp_congestion_control = {{ sysctl_tcp_congestion_control | default('bbr') }}

# TCP Fast Open (短命コネクションの初期レイテンシ削減)
net.ipv4.tcp_fastopen = {{ sysctl_tcp_fastopen | default(3) }}

# TIME_WAIT の再利用・高速化
net.ipv4.tcp_tw_reuse = {{ sysctl_tcp_tw_reuse | default(1) }}
net.ipv4.tcp_fin_timeout = {{ sysctl_tcp_fin_timeout | default(15) }}

# TCP Keepalive (gRPC / etcd / DB 接続ハングの迅速検知)
net.ipv4.tcp_keepalive_time = {{ sysctl_tcp_keepalive_time | default(600) }}
net.ipv4.tcp_keepalive_intvl = {{ sysctl_tcp_keepalive_intvl | default(30) }}
net.ipv4.tcp_keepalive_probes = {{ sysctl_tcp_keepalive_probes | default(5) }}

# エフェメラルポート範囲拡張 (短命コネクションのポート枯渇防止)
net.ipv4.ip_local_port_range = {{ sysctl_ip_local_port_range | default('10240 65535') }}

# リバースパスフィルタリング (CNI / 仮想ブリッジ非対称ルーティングパケットの誤破棄防止: 2=loose)
net.ipv4.conf.all.rp_filter = {{ sysctl_rp_filter | default(2) }}
net.ipv4.conf.default.rp_filter = {{ sysctl_rp_filter | default(2) }}

# バッファ拡張
net.core.rmem_max = {{ sysctl_rmem_max | default(16777216) }}
net.core.wmem_max = {{ sysctl_wmem_max | default(16777216) }}
net.ipv4.tcp_rmem = {{ sysctl_tcp_rmem | default('4096 87380 16777216') }}
net.ipv4.tcp_wmem = {{ sysctl_tcp_wmem | default('4096 87380 16777216') }}

# SYN Flood 耐性
net.ipv4.tcp_syncookies = {{ sysctl_tcp_syncookies | default(1) }}

# ARP キャッシュ上限緩和 (Pod / veth 多重化対応)
net.ipv4.neigh.default.gc_thresh1 = {{ sysctl_gc_thresh1 | default(4096) }}
net.ipv4.neigh.default.gc_thresh2 = {{ sysctl_gc_thresh2 | default(8192) }}
net.ipv4.neigh.default.gc_thresh3 = {{ sysctl_gc_thresh3 | default(16384) }}

# コネクショントラッキング上限緩和
net.netfilter.nf_conntrack_max = {{ sysctl_nf_conntrack_max | default(1048576) }}
net.netfilter.nf_conntrack_tcp_timeout_established = {{ sysctl_nf_conntrack_tcp_timeout_established | default(86400) }}

# メモリ・スワップ・キャッシュ制御 (Kubernetes / Ceph / DB 最適化)
vm.swappiness = {{ sysctl_swappiness | default(1) }}
vm.vfs_cache_pressure = {{ sysctl_vfs_cache_pressure | default(50) }}
vm.overcommit_memory = {{ sysctl_overcommit_memory | default(1) }}

# I/O 集中時のハング緩和 (CDI / Ceph 書き込み対策)
vm.dirty_background_ratio = {{ sysctl_dirty_background_ratio | default(5) }}
vm.dirty_ratio = {{ sysctl_dirty_ratio | default(10) }}

# ファイル監視・メモリマップ・非同期I/O・PID上限緩和
fs.inotify.max_user_watches = {{ sysctl_inotify_max_user_watches | default(1048576) }}
fs.inotify.max_user_instances = {{ sysctl_inotify_max_user_instances | default(16384) }}
fs.aio-max-nr = {{ sysctl_aio_max_nr | default(1048576) }}
vm.max_map_count = {{ sysctl_vm_max_map_count | default(1048576) }}
kernel.pid_max = {{ sysctl_pid_max | default(4194304) }}
