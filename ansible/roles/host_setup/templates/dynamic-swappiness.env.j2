# 動的 swappiness ガバナー設定
# SSOT: config.env (DYNAMIC_SWAPPINESS_*) / ansible/group_vars/all.yml
#
# load% = 1 分 loadavg ÷ CPU コア数 × 100
#   load% >= DYNAMIC_SWAPPINESS_HIGH_LOAD -> vm.swappiness = DYNAMIC_SWAPPINESS_MIN
#   load% <= DYNAMIC_SWAPPINESS_LOW_LOAD  -> vm.swappiness = DYNAMIC_SWAPPINESS_MAX
#   その間は線形補間
DYNAMIC_SWAPPINESS_LOW_LOAD={{ dynamic_swappiness_low_load }}
DYNAMIC_SWAPPINESS_HIGH_LOAD={{ dynamic_swappiness_high_load }}
DYNAMIC_SWAPPINESS_MIN={{ dynamic_swappiness_min }}
DYNAMIC_SWAPPINESS_MAX={{ dynamic_swappiness_max }}
