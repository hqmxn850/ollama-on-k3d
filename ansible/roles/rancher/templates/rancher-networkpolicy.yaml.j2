---
# ==========================================================
# ④ Application Plane Protection NetworkPolicy: Rancher (cattle-system)
# ==========================================================
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: rancher-app-protection
  namespace: {{ rancher_namespace | default('cattle-system') }}
spec:
  podSelector: {}
  policyTypes:
    - Ingress
    - Egress
  ingress:
    # 1. 同一名前空間内のマイクロサービス間通信
    - from:
        - podSelector: {}

    # 2. Traefik Ingress (kube-system) からの Web アクセス
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ kube_system_namespace | default('kube-system') }}
          podSelector:
            matchLabels:
              app.kubernetes.io/name: traefik

    # 3. Prometheus (cattle-monitoring-system) からのメトリクス収集
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ monitoring_namespace | default('cattle-monitoring-system') }}

    # 4. Kubernetes API Server からの Admission Webhook 通信 (rancher-webhook)
    - ports:
        - protocol: TCP
          port: 9443

  egress:
    # 認可されたクラスタ内サービス (Keycloak OIDC, API Server, DNS, Node Agent) への通信
    - {}
