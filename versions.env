# ==============================================================================
# versions.env - Ollama on K3D バージョン情報定義ファイル
#
# このファイルは Kubernetes (K3s)、主要 Helm Chart、および各種コンテナイメージの
# バージョン情報を一元管理します。
# start.sh 実行時に自動で読み込まれ、設定値を上書きして常に最新のバージョンで
# クラスタを起動・構築できることを保証します。
# upgrade.sh 実行時にも、自動検索された最新バージョンがこのファイルに反映されます。
# ==============================================================================

# --- Kubernetes (K3s) ---
K3S_VERSION="v1.36.5+k3s1"
IMAGE="rancher/k3s:v1.36.5-k3s1"

# --- Helm Chart バージョン ---
CERT_MANAGER_CHART_VERSION="v1.21.2"
KEYCLOAK_PG_CHART_VERSION="18.12.4"
KEYCLOAK_CHART_VERSION="3.0.12"
RANCHER_CHART_VERSION="2.15.2"
KUBE_PROMETHEUS_STACK_CHART_VERSION="91.4.1"
RANCHER_MONITORING_DASHBOARDS_CHART_VERSION="110.0.1+up0.1.4"
AMD_GPU_CHART_VERSION="0.22.0"
OLLAMA_CHART_VERSION="1.84.0"
OPEN_WEBUI_CHART_VERSION="16.6.0"

# --- コンテナイメージ バージョン / タグ ---
PGADMIN_IMAGE="docker.io/dpage/pgadmin4:latest"
AMD_GPU_DEVICE_PLUGIN_TAG="1.31.0.9"

# --- OnnxRuntime GenAI (OGA) ---
OGA_VERSION="0.17.1"
OGA_IMAGE="docker.io/library/python:3.12-slim"

# --- Open WebUI ---
OPEN_WEBUI_IMAGE_TAG="v0.11.4"
